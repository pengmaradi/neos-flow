// TODO Neos.Neos-20251005080230 Line 18: You may need to rewrite "VARIABLE.path" to Neos.Node.path(VARIABLE). We did not auto-apply this migration because we cannot be sure whether the variable is a Node.
// TODO Neos.Neos-20251005080230 Line 21: You may need to rewrite "VARIABLE.path" to Neos.Node.path(VARIABLE). We did not auto-apply this migration because we cannot be sure whether the variable is a Node.
prototype(Custom.Template:Helper.ScriptTag) < prototype(Neos.Fusion:Component) {
    path = null
    defer = true

    @if.hasPath = ${this.path}

    renderer = Neos.Fusion:Tag {
        tagName = 'script'
        attributes {
            defer = ${props.defer}
            //type="text/javascript"

            // internal resource
            @context.srcInternal = Neos.Fusion:ResourceUri {
                path = ${props.path}
            }
            // check if external resouce
            src = ${!String.startsWith(props.path, 'resource:') ? props.path : srcInternal}

        }
    }
}
