prototype(Custom.Template:Helper.StyleTag) < prototype(Neos.Fusion:Component) {
    path = null
    defer = true

    @if.hasPath = ${this.path}

    renderer = Neos.Fusion:Tag {
        tagName = 'link'

        @context.srcInternal = Neos.Fusion:ResourceUri {
            path = ${props.path}
        }

        attributes {
            rel = 'stylesheet'
            href = ${!String.startsWith(props.path, 'resource:') ? props.path : srcInternal}
            media = ${props.media ? props.media : 'all'}
        }
    }
}
