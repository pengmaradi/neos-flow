prototype(Custom.Template:Content.News.List) < prototype(Flowpack.Listable:PaginatedCollection) {
    
    itemsPerPage = ${q(node).property('limit') || '10'}
    maximumNumberOfLinks = 10
    // showPreviousNextLinks = true
    showPages = ${q(node).property('showPages')}

    // 1. reset news page as `news-p` in Setings.yaml
    // 2. use EEL helper `Custom.Template.Argument` get `news-p`
    currentPage = ${Custom.Template.Argument.get('news-p')}

    @process.list = Flowpack.Listable:List {
        wrapClass = 'news list my-5'
        listTitle = ${q(node).property('title')}
        listTitleClass = 'text-xl text-sky-400/90 mb-5'
        archiveLink = ${q(node).property('link')}
        archveLinkTitle = ${q(node).property('allnews')}
    }
    
    collection = ${q(site).parent().find('[instanceof Custom.Template:Document.News]').sort('date', 'DESC').get()}

    @context.container = ${(q(node).property('sectionWidth') == 'big' ? '' : 'container')}

    prototype(Flowpack.Listable:Pagination) {
        class = 'pagination inline-flex -space-x-px rounded-md'
        itemClass = 'relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 inset-ring inset-ring-gray-700 hover:bg-white/5 focus:z-20 focus:outline-offset-0'
        currentItemClass = 'isCurrent bg-indigo-500'

        renderer = Neos.Fusion:Loop {
            @process.tmpl = ${'<nav class="nav-pagination my-5"><ul class="' + props.class + '">' + value + '</ul></nav>'}
        }
    }

    prototype(Flowpack.Listable:Collection) {
        @context.title = ${q(documentNode).property('title')}
        @process.tmpl = ${'<div class="article-list"><div class="listable grid grid-cols-3 gap-3">' + value + '</div></div>'}

        itemRenderer.@process.tmpl = ${value}
        itemName = 'node'
        iterationName = 'iterator'
        itemRenderer = Custom.Template:Content.News.Teaser
    }
}