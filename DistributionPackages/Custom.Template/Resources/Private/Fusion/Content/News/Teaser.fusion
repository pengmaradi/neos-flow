prototype(Custom.Template:Content.News.Teaser) < prototype(Neos.Neos:ContentComponent) {

    title = ${q(node).property('title')}

    teaser = ${q(node).property('teaser')}

    date = ${Date.format(q(node).property('date'), 'd.m.Y')}

    uriPathSegment = ${q(node).property('uriPathSegment')}

    imageUri = Neos.Neos:ImageUri {
        asset = ${q(node).property('image')}
        width = 400
    }

    itemClass = 'news'

    renderer = afx`
        <div class={props.itemClass}>
			<div class="news-container relative flex flex-col justify-center items-center text-white hover:text-black rounded-lg shadow-2xl hover:shadow-xl/30 cursor-pointer bg-center group relative"
                 style={'background: url(' + props.imageUri +  ');background-size: cover;height:300px;background-position: center;'}>
				<h3 class="p-2 w-full text-sky-500 group-hover:text-white group-hover:shadow-lg/30 group-hover:bg-gray-400/50 animate">{String.crop(props.title, 10, '...')}</h3>
				<p>{props.date}</p>
				<Neos.Neos:NodeLink
                    node={node}
                    attributes.title={props.title}
                    attributes.class="absolute inset-0">
				</Neos.Neos:NodeLink>
			</div>
        </div>
    `
}