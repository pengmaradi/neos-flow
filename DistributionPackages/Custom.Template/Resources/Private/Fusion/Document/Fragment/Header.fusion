prototype(Custom.Template:Document.Fragment.Header) < prototype(Neos.Fusion:Component) {

    logoLink = ''
    menu = ''
    language = ''
    
    @styleguide.props {
        homeUri = '#' // 设置首页的链接地址
        currentLanguage = 'en_US' // 设置当前语言环境
        menuItems = Neos.Fusion:Map { // 遍历数组并处理每个元素的 Fusion 对象
            items = ${['Home', 'Features', 'Try me', 'Download']} // 包含主菜单项的数组 ['Home', 'Features', 'Try me', 'Download']
            itemRenderer = Neos.Fusion:DataStructure {
                label = ${item}
                uri = ${'#' + item}
                subItems = Neos.Fusion:Map {
                    @if.set = ${iterator.isEven} // 条件：只在偶数索引项显示子菜单
                    items = ${['Sub item 1', 'Sub item 2', 'Sub item 3']}
                    itemRenderer = Neos.Fusion:DataStructure {
                        label = ${item} // 菜单项显示文本
                        uri = ${'#' + item} // 菜单项链接
                    }
                }
            }
        }
    }

    @context.currentUriPath = ${request.httpRequest.uri.path} // /en/
    fullUrl = ${request.httpRequest.uri.composedComponents} // https://flow.test/en/search.html
    query = ${request.httpRequest.uri.query} // search=news
    // /en/
    @context.homeUri = Neos.Neos:NodeUri {
        node = ${q(site).get(0)}
    }

    isHome = ${currentUriPath == homeUri}
    
    renderer = afx`
        <header class="header z-10 sticky top-0 bg-white shadow-black dark:bg-gray-900 dark:shadow-white">

            <div class="flex justif-center items-center my-auto w-full" x-data="mainMenu">
                {props.logoLink}

                <div class="bars lg:invisible lg:hidden" :class="show && 'active'"></div>

                <nav class="nav" :class="show && 'active'">
                    <div class="deco"></div>
                    <ul class="navigation"
                        @if={Type.isArray(props.menu) && Array.length(props.menu)}>
                        <Neos.Fusion:Loop items={props.menu}>
                            <li class={item.state.value + ' relative lg:[&:hover>ul]:block [&.current>a]:text-sky-500 [&.active>a]:text-red-500' + (props.isHome && (currentUriPath == item.uri) ? ' current' : '')}>
                                <span @if={Type.isArray(item.children) && Array.length(item.children)} class="sr-only">.</span>
                                <a href={item.uri} class="block p-1 text-lg lg:text-sm whitespace-nowrap hover:text-sky-500"
                                >{item.label}</a>
                                <ul @if={Type.isArray(item.subItems) && Array.length(item.subItems)} class={'absolute lg:hidden level-' + item.menuLevel}>
                                    <Neos.Fusion:Loop items={item.subItems}>
                                        <li class={item.state.value + ' relative [&:hover>ul]:block'}><span class="sr-only" @if={Type.isArray(item.children) && Array.length(item.children)}>.</span>
                                            <a href={item.uri} class="block text-base p-1 whitespace-nowrap">{item.label}</a>
                                            <ul @if={Type.isArray(item.subItems) && Array.length(item.subItems)} class={'lg:hidden absolute top-0 -right-10 bg-sky-500 level-' + item.menuLevel}>
                                                <Neos.Fusion:Loop items={item.subItems}>
                                                    <li class={item.state.value}>
                                                        <a href={item.uri} class="block text-base p-1 whitespace-nowrap">{item.label}</a>
                                                    </li>
                                                </Neos.Fusion:Loop>
                                            </ul>
                                        </li>
                                    </Neos.Fusion:Loop>
                                </ul>
                            </li>
                        </Neos.Fusion:Loop>
                    </ul>
                </nav>
                <div class="language invisible lg:visible hidden lg:block">
                    {props.language}
                </div>
            </div>
      </header>
    `
}