prototype(Custom.Template:Document.Fragment.Menu.Main) < prototype(Neos.Neos:Menu) {

    maximumLevels = 3

    // set News not in menu
    filter = 'Neos.Neos:Document,!Custom.Template:Document.News'

    // default set li normal, current class
    calculateItemStates = true

    attributes = Neos.Fusion:DataStructure {
        class = "flex h-full space-x-8"
    }
}
