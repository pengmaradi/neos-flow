// TODO Neos.Neos-20251005080230 Line 16: You very likely need to rewrite "VARIABLE.label" to "Neos.Node.label(VARIABLE)". We did not auto-apply this migration because we cannot be sure whether the variable is a Node.
// TODO Neos.Neos-20251005080230 Line 20: You very likely need to rewrite "VARIABLE.label" to "Neos.Node.label(VARIABLE)". We did not auto-apply this migration because we cannot be sure whether the variable is a Node.
// TODO Neos.Neos-20251005080230 Line 5: You may need to rewrite "VARIABLE.path" to Neos.Node.path(VARIABLE). We did not auto-apply this migration because we cannot be sure whether the variable is a Node.
prototype(Custom.Template:Document.Fragment.Menu.Language) < prototype(Neos.Fusion:Component) {
  @context.currentUriPath = ${request.httpRequest.uri.path}
  
  menuItems = Neos.Neos:DimensionsMenuItems {
    dimension = 'language'
  }

  renderer = afx`
    <ul class="flex items-center justify-between self-center space-x-8" x-data>
      <Neos.Fusion:Loop items={props.menuItems}>
        <li @if.hasNode={item.node} class={item.uri == currentUriPath ? 'active': 'normal'}>
          <Neos.Neos:NodeLink node={item.node}>
            <span class="language-menu" title={item.label}>{item.label}</span>
          </Neos.Neos:NodeLink>
        </li>
        <li @if.hasNoNode={!item.node}>
          <span class="language-menu-short" title={item.label}>{item.label}</span>
        </li>
      </Neos.Fusion:Loop>
    </ul>
  `
}
