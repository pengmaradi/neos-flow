prototype(Custom.Template:Document.News) < prototype(Custom.Template:Document.AbstractPage) {
    body = Custom.Template:Component.Template.News {
        headerImage = Neos.Neos:ImageUri {
            asset = ${q(documentNode).property('image') ? q(documentNode).property('image') : null}
            width = 2560
        }

        teaser = ${q(node).property('teaser')}

        tags = ${q(node).property('tags')}

        categories = ${q(node).property('categories')}

        date = ${Date.format(q(node).property('date'), 'd.m.Y')}

        title = ${q(node).property('title')}
        description = ${q(node).property('description')}
        source_name = ${q(node).property('source_name')}
        author = ${q(node).property('author')}
        url = ${q(node).property('url')}
    }
}

prototype(Custom.Template:Component.Template.News) < prototype(Neos.Fusion:Component) {
    # Property API
    logo = ''
    menu = ''
    content = ''
    # news teaser ...
    teaser = ''
    description = ''
    source_name = ''
    imageClass = ''
    url = ''
    tags = null
    categories = null
    date = null
    title = ''

    headerImage = ''
    footer = ''

    currentUrl = Neos.Neos:NodeUri {
        node = ${node}
        absolute = true
    }

    # Template
  renderer = afx`
        <header class="header z-10 sticky top-0 bg-white shadow-black">
            <div class="container">
                <div class="flex justify-between self-center my-auto w-full">
                    <div class="logo h-5 w-5" @if={props.logo}>
                        <Neos.Neos:NodeLink node={q(site).get(0)} class="h-5 w-5 inline-block">{props.logo}</Neos.Neos:NodeLink>
                    </div>
                    <nav class="flex items-center self-center max-w-screen-lg">{props.menu}</nav>
                </div>
            </div>
        </header>
		<main class="container mx-auto min-h-[77vh]">
            <Neos.Neos:ImageTag
                preset="newsDetailThumbnail"
                asset={q(documentNode).property('image')}
                alt={props.title}
            />
			<h1 @if={props.title} class="my-5 text-2xl text-sky-500">{props.title}</h1>

            <a href={props.url} class="text-blue-300 relative mb-5 inline-block" target="_blank">{props.source_name}</a>
            <p @if={props.date} class="text-sm mb-5">{props.date}</p>
            <div class="description indent-8">{props.description}</div>
            <div class="teaser">{props.teaser}</div>

			<ul class="category mt-10 text-xs" @if={props.categories}>
				<Neos.Fusion:Loop items={props.categories} itemName="category" iterationName="iterator">
					<li class={'category__' + iterator.index}>cat: {category.properties.title}</li>
				</Neos.Fusion:Loop>
			</ul>
			<ul class="tag mt-10 text-xs" @if={props.tags}>
				<Neos.Fusion:Loop items={props.tags} itemName="tag" iterationName="iterator">
					<li class={'tag__' + iterator.index}>tag: {tag.properties.title}</li>
				</Neos.Fusion:Loop>
			</ul>
			{props.content}
		</main>
		
        <footer class="container mx-auto mt-30 p-5 bg-gray-600">
            {props.footer}
        </footer>
	
    `
}