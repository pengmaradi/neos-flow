prototype(Custom.Template:Document.NewsList) < prototype(Custom.Template:Document.AbstractPage) {
    body = Custom.Template:Component.News {
        limit = ${q(node).property('limit') || 3}
        news = ${q(documentNode).find('[instanceof Custom.Template:Document.News]').slice(0, this.limit).get()}
        currentUrl = ${q(documentNode).property('uriPathSegment')}
    }
}

prototype(Custom.Template:Component.News) < prototype(Custom.Template:Component.Template.Default) {
    limit = 3
    news = null

    renderer = afx`
        <div class="container mx-auto">
            <div class="headerImage flex items-center justify-center bg-contain bg-fixed bg-top" data-aos="fade-up" data-aos-duration="1000" @if={props.headerImage} style={'background-image: url(' +  props.headerImage + ');'}>
                <img class="w-full invisible" src={props.headerImage} />
            </div>
            <header class="header z-10 sticky top-0 bg-white shadow-black">
                <div class="container">
                    <div class="flex justify-between self-center my-auto w-full">
                            <div class="logo h-5 w-5" @if={props.logo}>
                                <Neos.Neos:NodeLink node={q(site).get(0)} class="h-5 w-5 inline-block">{props.logo}</Neos.Neos:NodeLink>
                            </div>
                            <nav class="flex items-center self-center max-w-screen-lg">{props.menu}</nav>
                            {props.language}
                    </div>
                </div>
            </header>
            <main class="container mx-auto">
                <div class="gap-4 grid grid-cols-3 lg:grid-cols-4">
                    <Neos.Fusion:Loop items={props.news} itemName="news" iterationName="iterator">
                        <div class={'news relative p-4 border rounded bg-sky-500/50 news_' + iterator.index}>
                            <h2 class="text-red-900 text-xl mb-5">{String.crop(news.properties.title, 15, '...')}</h2>
                            <Neos.Neos:ImageTag
                                @if={news.properties.image}
                                preset="newsThumbnail"
                                asset={news.properties.image} 
                                alt={news.properties.title}
                            />
                            <span>{Date.format(news.properties.date, 'd.m.Y')}</span>
                            <p class="text-sm break-all indent-8">{String.crop(news.properties.description, 100, '...')}</p>
                            <Neos.Neos:NodeLink attributes.class="absolute inset-0 h-full w-full" node={news}>
                                <span class="sr-only">Read more</span>
                            </Neos.Neos:NodeLink>
                        </div>
                    </Neos.Fusion:Loop>
                </div>
            </main>
            <footer class="container mx-auto mt-30 p-5 bg-gray-600">{props.footer}</footer>
        </div>
    `
}