prototype(Custom.Template:Document.NewsList) < prototype(Custom.Template:Document.AbstractPage) {
    body = Custom.Template:Component.News {
        limit = ${q(node).property('limit') || 3}
        news = ${q(documentNode).find('[instanceof Custom.Template:Document.News]').slice(0, this.limit).get()}
        currentUrl = ${q(documentNode).property('uriPathSegment')}
    }
}

prototype(Custom.Template:Component.News) < prototype(Custom.Template:Component.Template.Default) {
    limit = 3
    news = null

    divWrapper = Neos.Fusion:DataStructure {
        class {
          name = 'bodyWrapper'
          level = ${"level-" + (Neos.Node.depth(node) - 2)}
        }
    }

    renderer = afx`
        <Custom.Template:Document.Fragment.DarkMode />
        <Custom.Template:Document.Fragment.QuickTotop />

        <div class="container mx-auto">
            <Custom.Template:Document.Fragment.HeaderImage @if={props.headerImage} {...props} />
            <Custom.Template:Document.Fragment.Header {...props} />

            <main {...props.divWrapper}>
                <h1 class="text-sky-500 text-3xl my-15">{props.title}</h1>

                <div class="gap-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
                    <Neos.Fusion:Loop items={props.news} itemName="news" iterationName="iterator">
                        <div class={'news relative p-4 border border-transparent  rounded-xl bg-sky-500/20 hover:bg-sky-500/50 shadow-xl/30 animate news_' + iterator.index}>
                            <h2 class="text-red-900 text-xl mb-5">{String.crop(news.properties.title, 15, '...')}</h2>
                            <Neos.Neos:ImageTag
                                @if={news.properties.image}
                                preset="newsThumbnail"
                                asset={news.properties.image} 
                                alt={news.properties.title}
                            />
                            <span>{Date.format(news.properties.date, 'd.m.Y')}</span>
                            <p class="text-sm break-all indent-8">{String.crop(news.properties.description, 100, '...')}</p>
                            <Neos.Neos:NodeLink attributes.class="absolute inset-0 h-full w-full" node={news}>
                                <span class="sr-only">Read more</span>
                            </Neos.Neos:NodeLink>
                        </div>
                    </Neos.Fusion:Loop>
                </div>
            </main>
            
            <Custom.Template:Document.Fragment.Footer />
        </div>
    `
}