
[v-cloak],
[x-cloak] {
    display: none;
}

body {
    @apply bg-gray-900/50 dark:bg-gray-900/90 dark:text-gray-300;
}

.animate {
    @apply transition duration-500 transition-all;
}

.gray-box-shadow {
    box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.1);
}

@keyframes display-white-background {
    0% {
        background: rgba(255, 255, 255, 0);
    }

    25% {
        background: rgba(255, 255, 255, 0.25);
    }

    50% {
        background: rgba(255, 255, 255, 0.5);
    }

    75% {
        background: rgba(255, 255, 255, 0.75);
    }

    100% {
        background: rgba(255, 255, 255, 1);
    }
}


