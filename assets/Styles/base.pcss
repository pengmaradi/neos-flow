
[v-cloak],
[x-cloak] {
    display: none;
}

body {
    @apply font-kameron bg-gray-900/50 dark:bg-gray-900/90 dark:text-gray-300;
}

h1 {
    @apply font-mochiy text-3xl mb-8;
}

h2 {
    @apply font-comnis text-2xl mb-4;
}

h3 {
    @apply font-oswald text-xl mb-3;
}

.animate {
    @apply transition duration-500 transition-all;
}

.gray-box-shadow {
    box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.1);
}

@keyframes display-white-background {
    0% {
        background: rgba(255, 255, 255, 0);
    }

    25% {
        background: rgba(255, 255, 255, 0.25);
    }

    50% {
        background: rgba(255, 255, 255, 0.5);
    }

    75% {
        background: rgba(255, 255, 255, 0.75);
    }

    100% {
        background: rgba(255, 255, 255, 1);
    }
}

/**
 * only on neos cms!!!
 * url('../Custom.Template/pathTo.img')
 */
a[href^="tel:"] {
    @apply relative pl-7.5;
    &:before {
        @apply absolute left-0 top-0 w-5 h-5 content-[url('../Custom.Template/Images/phone.svg')];
    }
}

a[href^="mailto:"] {
    @apply relative pl-7.5;
    &:before {
        @apply absolute left-0 top-0 w-7.5 h-10 content-[url('../Custom.Template/Images/mail.svg')];
    }
}

.main-circle {
    img {
        @apply rounded-full w-60 h-60 object-cover shadow-xl/30 absolute top-0 left-0;
    }
}
